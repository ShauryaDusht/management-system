SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
SERVER_IP=YOUR_LOCAL_NETWORK_IP

ALLOWED_HOSTS=localhost,127.0.0.1,backend,${SERVER_IP},campussanchalika.iitgn.ac.in

DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_PORT=5432
DB_HOST=db
DB_ENGINE=django.db.backends.postgresql

CORS_ALLOWED_ORIGINS=https://${SERVER_IP},https://campussanchalika.iitgn.ac.in
CSRF_TRUSTED_ORIGINS=https://${SERVER_IP},https://campussanchalika.iitgn.ac.in
USE_X_FORWARDED_HOST=True
IMAGE_DEBUG_LOGS=False

# Production safety defaults: keep live dashboard edits persistent across restarts.
RUN_SEED_ON_STARTUP=false
RUN_DATA_SYNC_ON_STARTUP=false
RUN_WEEKLY_SEED_UPDATE=false

# Optional SQL backup restore on backend startup.
# Put backups in /srv/campussanchalika/backups on the host; it maps to /app/backups.
# Leave disabled normally. Enable only for a fresh/empty DB restore.
RESTORE_SQL_BACKUP_ON_STARTUP=false
# SQL_RESTORE_FILE=/app/backups/backup_20260603_2332.sql
SQL_RESTORE_FORCE=false
